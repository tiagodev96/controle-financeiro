# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth — login com email + senha + allowlist server-only.
# AUTH_ENABLED gateia a UI de login. Em prod: começa false; vira true após
# smoke test. Em dev: true.
AUTH_ENABLED=true
# Allowlist server-only (CSV). NÃO usar NEXT_PUBLIC_ — não expor no bundle.
# Em local convém incluir os fixture users do seed (owner@example.com,
# empty@example.com) pra desenvolvimento manual e E2E funcionarem.
AUTH_ALLOWED_EMAILS=you@example.com,partner@example.com

# Cron — segredo enviado no header Authorization: Bearer <CRON_SECRET> pelo
# Vercel Cron. Em prod gere algo robusto (openssl rand -hex 32). Em local
# qualquer string serve. Sem isso, os endpoints /api/cron/* retornam 401.
CRON_SECRET=
